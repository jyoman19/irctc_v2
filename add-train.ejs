<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Add Train</title>
</head>
<body>
  <h2>Add New Train</h2>

  <% if (message) { %>
    <p><%= message %></p>
  <% } %>
  
  <form method="POST" action="/add-train">
    <label for="train_number">Train Number:</label>
    <input type="text" name="train_number" required placeholder="Enter train number">
    <br><br>

    <label for="train_name">Train Name:</label>
    <input type="text" name="train_name" required placeholder="Enter train name">
    <br><br>

    <label for="total_seats">Total Seats:</label>
    <input type="number" name="total_seats" required placeholder="Enter total seats">
    <br><br>

    <button type="submit">Add Train</button>
  </form>

  <br>
  <a href="/">Back to Home</a>
</body>
</html>
